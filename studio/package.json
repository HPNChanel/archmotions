{
  "name": "archmotion-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ArchMotion Studio — browser-based visual editor for system architecture animations. Zero-cost, fully client-side (Pyodide + ffmpeg.wasm).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@uiw/react-codemirror": "^4.23.7",
    "@xyflow/react": "^12.4.4",
    "lottie-web": "^5.12.2",
    "pyodide": "^0.26.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
